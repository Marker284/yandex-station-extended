#!/bin/sh
# yse — Yandex Station Extended package manager (клиент для устройства)
# Скачать / обновить: https://github.com/Marker284/yandex-station-extended/blob/main/contrib/bin/yse
# Установщик с ПК:    https://github.com/Marker284/yandex-station-extended/blob/main/contrib/install-yse.sh
# Документация:       https://hackalice.me/start/packages/
# Два источника пакетов, всё ставится в /data/opt (rootfs только для чтения):
#   ent — Entware (opkg): тысячи пакетов под embedded ARM, self-contained в /opt;
#   yap — реестры .yap на GitHub (формат yapkg: index.json + архивы с plugin.toml),
#         по умолчанию https://github.com/nyakokitsu/yapkg; только aarch64.
#
#   yse bootstrap              развернуть Entware (один раз; нужен и для .yap)
#   yse update                 обновить индексы Entware и .yap-реестров
#   yse install <pkg>...       установить (ent:<pkg> / yap:<pkg> — из конкретного источника)
#   yse remove  <pkg>...       удалить
#   yse list [-a]              установленные (или -a: все доступные)
#   yse search <строка>
#   yse info <pkg>
#   yse upgrade                обновить установленные
#   yse sources                список .yap-реестров (/data/opt/etc/yse/sources)
#   yse env                    окружение для текущей сессии: eval "$(yse env)"
#   yse help
#
# Без префикса пакет берётся из Entware, а если там его нет — из .yap-реестров
# (порядок меняется переменной YSE_PREFER=yap).
#
set -u

# ---------- конфигурация ----------
YSE_ROOT="${YSE_ROOT:-/data/opt}"
OPT=/opt
OPKG="$OPT/bin/opkg"
ENT_MIRROR="${YSE_ENT_MIRROR:-http://bin.entware.net}"
YSE_PREFER="${YSE_PREFER:-ent}"
YAP_DIR="$YSE_ROOT/yap"                 # установленные .yap: $YAP_DIR/<id>/
YAP_BIN="$YSE_ROOT/bin"                 # запускалки
YAP_SOURCES="$YSE_ROOT/etc/yse/sources" # реестры: "<имя> <url index.json>"
YAP_CACHE="$YSE_ROOT/var/yse"           # разобранные индексы: <имя>.tsv
YAP_DEFAULT_SOURCE="yapkg https://raw.githubusercontent.com/nyakokitsu/yapkg/registry/index.json"
TAB="$(printf '\t')"

# арка (override через YSE_ARCH)
if [ -n "${YSE_ARCH:-}" ]; then ARCH="$YSE_ARCH"; else
    case "$(uname -m 2>/dev/null)" in
        aarch64|arm64) ARCH=aarch64 ;;
        armv7l|armv6l|arm) ARCH=armv7 ;;
        *) ARCH="$(uname -m)" ;;
    esac
fi
ent_arch(){ case "$ARCH" in aarch64) echo aarch64-k3.10 ;; armv7) echo armv7sf-k3.2 ;; *) echo "" ;; esac; }
ent_ready(){ [ -x "$OPKG" ]; }
opkg(){ PATH="$OPT/bin:$OPT/sbin:$PATH" "$OPKG" "$@"; }

# ---------- утилиты ----------
msg(){ echo "[yse] $*"; }
err(){ echo "[yse] ошибка: $*" >&2; }
die(){ err "$*"; exit 1; }
fetch(){ wget -q -O "$2" "$1" 2>/dev/null; }     # busybox wget (http)
need_ent(){ ent_ready || die "Entware не развёрнут. Выполни: yse bootstrap"; }
rootfs_ro(){ awk '$2=="/"{print $4}' /proc/mounts | grep -q '^ro'; }  # busybox `test -w` не видит ro-монтирование

# HTTPS-загрузка: busybox wget умеет только http, поэтому curl (или wget) из Entware
fetch_https(){
    need_ent
    if [ -x "$OPT/bin/curl" ]; then
        LD_LIBRARY_PATH="$OPT/lib" "$OPT/bin/curl" -fsSL --retry 2 -o "$2" "$1"
    elif [ -x "$OPT/bin/wget" ]; then
        LD_LIBRARY_PATH="$OPT/lib" "$OPT/bin/wget" -q -O "$2" "$1"
    else
        msg "для загрузки с GitHub нужен curl — ставлю из Entware"
        opkg install curl >/dev/null 2>&1 && [ -x "$OPT/bin/curl" ] || die "не удалось поставить curl (yse install curl)"
        LD_LIBRARY_PATH="$OPT/lib" "$OPT/bin/curl" -fsSL --retry 2 -o "$2" "$1"
    fi
}

# PATH для /data/opt/bin и /opt/bin через /etc/profile.d (rootfs rw)
ensure_profile(){
    pf=/etc/profile.d/yse.sh
    [ -f "$pf" ] && return 0
    rw=0; rootfs_ro && { mount -o remount,rw / 2>/dev/null && rw=1; }
    if { printf '%s\n' \
            '[ -d /data/opt/bin ] && PATH="/data/opt/bin:$PATH"' \
            '[ -d /opt/bin ] && PATH="/opt/bin:/opt/sbin:$PATH"' \
            'export PATH' \
            'export HOME=/data/opt/home; mkdir -p "$HOME" 2>/dev/null' \
            '[ -r /opt/etc/profile ] && . /opt/etc/profile'; } > "$pf" 2>/dev/null; then
        chmod 644 "$pf" 2>/dev/null; msg "PATH прописан в $pf (подхватится при следующем входе)"
    else err "не удалось записать $pf (PATH не прописан)"; fi
    [ "$rw" = 1 ] && { sync; mount -o remount,ro / 2>/dev/null; }
}

# ---------- Entware ----------
# /opt должен указывать в записываемое /data/opt/entware (на заводе /opt — пустой
# каталог на RO-rootfs, его надо заменить симлинком)
ensure_opt(){
    target="$YSE_ROOT/entware"
    mkdir -p "$target"
    [ -L "$OPT" ] && return 0                                  # уже симлинк — ок
    if [ -e "$OPT" ] && [ ! -d "$OPT" ]; then die "$OPT существует и это не каталог"; fi
    if [ -d "$OPT" ] && [ -n "$(ls -A "$OPT" 2>/dev/null)" ]; then
        die "$OPT — непустой каталог; освободи его вручную и повтори"
    fi
    msg "настраиваю $OPT -> $target (нужен rootfs rw)"
    mount -o remount,rw / 2>/dev/null || die "не удалось сделать rootfs записываемым"
    [ -d "$OPT" ] && rmdir "$OPT" 2>/dev/null
    if ln -s "$target" "$OPT" 2>/dev/null; then sync; mount -o remount,ro / 2>/dev/null
    else mount -o remount,ro / 2>/dev/null; die "не создать симлинк $OPT"; fi
}

cmd_bootstrap(){
    ea="$(ent_arch)"
    [ -n "$ea" ] || die "Entware не поддерживает арку '$ARCH' (есть aarch64 и armv7)"
    ensure_profile
    if ent_ready; then msg "Entware уже установлен ($OPKG)"; opkg update; return 0; fi
    ensure_opt
    url="$ENT_MIRROR/$ea/installer/generic.sh"
    msg "Entware bootstrap ($ea): $url"
    fetch "$url" /tmp/entware-generic.sh || die "не скачать установщик. busybox wget без TLS: если зеркало редиректит на https — поставь Entware с помощью хоста или задай http-зеркало через YSE_ENT_MIRROR"
    [ -s /tmp/entware-generic.sh ] || die "установщик пуст"
    sh /tmp/entware-generic.sh || die "установщик Entware завершился с ошибкой"
    ent_ready || die "opkg не появился в $OPKG"
    # /opt/etc/shells симлинкован на RO /etc/shells -> сделать реальным файлом,
    # иначе postinst shell-пакетов (fish/bash/zsh) падает с Read-only
    if [ -L /opt/etc/shells ]; then
        c="$(cat /opt/etc/shells 2>/dev/null)"; rm -f /opt/etc/shells
        printf '%s\n' "$c" > /opt/etc/shells 2>/dev/null && msg "/opt/etc/shells -> реальный файл"
    fi
    opkg update && msg "Entware готов. opkg: $OPKG, пакеты в $OPT" || err "opkg update не прошёл (проверь сеть)"
}

ent_has(){ ent_ready && opkg list 2>/dev/null | awk -v n="$1" '$1==n{f=1} END{exit !f}'; }
ent_installed(){ ent_ready && opkg list-installed 2>/dev/null | awk -v n="$1" '$1==n{f=1} END{exit !f}'; }

# ---------- .yap-реестры ----------
yap_sources(){
    if [ -s "$YAP_SOURCES" ]; then grep -vE '^[[:space:]]*(#|$)' "$YAP_SOURCES"
    else echo "$YAP_DEFAULT_SOURCE"; fi
}

# index.json (format 1, по ключу на строку) -> TSV: id version sha256 url description
yap_parse_index(){
    awk '
    function val(s) { sub(/^[^:]*:[[:space:]]*"/, "", s); sub(/",?[[:space:]]*$/, "", s); gsub(/\\"/, "\"", s); return s }
    /"id":/          { id = val($0) }
    /"version":/     { ver = val($0) }
    /"sha256":/      { sha = val($0) }
    /"url":/         { url = val($0) }
    /"description":/ { desc = val($0) }
    /^[[:space:]]*}/ { if (id != "" && ver != "" && sha != "" && url != "") printf "%s\t%s\t%s\t%s\t%s\n", id, ver, sha, url, desc
                       id = ver = sha = url = desc = "" }
    ' "$1"
}

cmd_yap_update(){
    mkdir -p "$YAP_CACHE"
    yap_sources | while read -r name url; do
        [ -n "$name" ] && [ -n "$url" ] || continue
        tmp="$YAP_CACHE/.$name.json"
        if fetch_https "$url" "$tmp" && yap_parse_index "$tmp" > "$YAP_CACHE/$name.tsv.new" && [ -s "$YAP_CACHE/$name.tsv.new" ]; then
            mv "$YAP_CACHE/$name.tsv.new" "$YAP_CACHE/$name.tsv"
            msg "yap/$name: $(wc -l < "$YAP_CACHE/$name.tsv") пакетов"
        else
            rm -f "$YAP_CACHE/$name.tsv.new"; err "yap/$name: не удалось обновить индекс ($url)"
        fi
        rm -f "$tmp"
    done
}

yap_ensure_index(){ ls "$YAP_CACHE"/*.tsv >/dev/null 2>&1 || cmd_yap_update >&2; }   # вызывается внутри $(...)

# строка индекса "<источник>\t<id>\t<version>\t<sha>\t<url>\t<desc>" для пакета (первый реестр по списку)
yap_lookup(){
    yap_ensure_index
    yap_sources | while read -r name url; do
        [ -f "$YAP_CACHE/$name.tsv" ] || continue
        awk -F "$TAB" -v id="$1" -v s="$name" '$1==id{print s "\t" $0; f=1; exit} END{exit !f}' "$YAP_CACHE/$name.tsv" && break
    done
}

# имя пакета как в yapkg: защищает пути /data/opt/yap/<id> от "../" и пустого id
yap_valid_id(){ echo "$1" | grep -qE '^[a-z0-9][a-z0-9_-]*$'; }
yap_installed(){ yap_valid_id "$1" && [ -f "$YAP_DIR/$1/.yse" ]; }
yap_field(){ sed -n "s/^$2=//p" "$YAP_DIR/$1/.yse" 2>/dev/null; }

# путь запуска из plugin.toml: секция [launch], ключ path
yap_launch_path(){
    awk '/^\[/{sec=$0} sec=="[launch]" && /^[[:space:]]*path[[:space:]]*=/{sub(/^[^=]*=[[:space:]]*"/,""); sub(/".*$/,""); print; exit}' "$1"
}

yap_install_one(){
    id="$1"
    yap_valid_id "$id" || { err "yap: недопустимое имя пакета '$id'"; return 1; }
    [ "$ARCH" = aarch64 ] || die ".yap-пакеты собраны только под aarch64 (здесь $ARCH)"
    line="$(yap_lookup "$id")"
    [ -n "$line" ] || { err "yap: пакета '$id' нет в реестрах (yse update?)"; return 1; }
    src=$(echo "$line" | cut -f1); ver=$(echo "$line" | cut -f3); sha=$(echo "$line" | cut -f4); url=$(echo "$line" | cut -f5)
    if yap_installed "$id" && [ "$(yap_field "$id" version)" = "$ver" ]; then
        msg "yap:$id $ver уже установлен"; return 0
    fi
    mkdir -p "$YAP_DIR" "$YAP_BIN"
    tmp="$YAP_DIR/.dl-$id.yap"; stage="$YAP_DIR/.stage-$id"
    rm -rf "$tmp" "$stage"
    msg "yap:$id $ver ($src): скачиваю"
    fetch_https "$url" "$tmp" || { rm -f "$tmp"; err "yap:$id: не скачать $url"; return 1; }
    [ "$(sha256sum "$tmp" | cut -d' ' -f1)" = "$sha" ] || { rm -f "$tmp"; err "yap:$id: sha256 не совпал, пакет отвергнут"; return 1; }
    # распакованный пакет примерно в 2,5 раза больше архива; оставляем 5 МБ запаса
    need=$(( $(wc -c < "$tmp") * 5 / 2 / 1024 + 5120 ))
    free=$(df -k "$YAP_DIR" | awk 'NR==2{print $4}')
    [ "$free" -gt "$need" ] || { rm -f "$tmp"; err "yap:$id: мало места (нужно ~$((need/1024)) МБ, свободно $((free/1024)) МБ)"; return 1; }
    mkdir -p "$stage"
    gunzip -c "$tmp" | tar -xf - -C "$stage" || { rm -rf "$tmp" "$stage"; err "yap:$id: архив повреждён"; return 1; }
    rm -f "$tmp"
    [ -f "$stage/plugin.toml" ] || { rm -rf "$stage"; err "yap:$id: в архиве нет plugin.toml"; return 1; }
    grep -q '"arch.aarch64"' "$stage/plugin.toml" || msg "yap:$id: в plugin.toml не указан arch.aarch64 — пробую всё равно"
    lp="$(yap_launch_path "$stage/plugin.toml")"
    case "$lp" in ""|/*|*..*) rm -rf "$stage"; err "yap:$id: некорректный [launch] path '$lp'"; return 1 ;; esac
    [ -f "$stage/$lp" ] || { rm -rf "$stage"; err "yap:$id: нет файла $lp"; return 1; }
    # в архивах файлы без бита исполнения
    chmod 755 "$stage/$lp"
    find "$stage" -type f \( -path '*/bin/*' -o -path '*/libexec/*' -o -name '*-run' -o -name 'ld-musl-*' \) -exec chmod 755 {} \;
    cmd="${lp##*/}"
    wrapper="$YAP_BIN/$cmd"
    if [ -e "$wrapper" ] && ! grep -q "^# yse-yap $id\$" "$wrapper" 2>/dev/null; then
        rm -rf "$stage"; err "yap:$id: $wrapper уже существует и не от yse — не перезаписываю (удали его сам)"; return 1
    fi
    # перенос на место: старую версию убираем только после успешной распаковки новой
    rm -rf "$YAP_DIR/$id.old"; [ -d "$YAP_DIR/$id" ] && mv "$YAP_DIR/$id" "$YAP_DIR/$id.old"
    mv "$stage" "$YAP_DIR/$id" && rm -rf "$YAP_DIR/$id.old"
    # чем запускать: обёртка пакета <dir>/*-run, у которой BIN указывает на наш бинарник (свой ld-musl,
    # LD_LIBRARY_PATH, TERMINFO), иначе сам бинарник (статические сборки)
    runner="$YAP_DIR/$id/$lp"
    case "$lp" in
        */*) for r in "$YAP_DIR/$id/${lp%%/*}"/*-run; do
                 [ -f "$r" ] && grep -q "BIN=\"\$DIR/${lp#*/}\"" "$r" && { runner="$r"; break; }
             done ;;
    esac
    printf '#!/bin/sh\n# yse-yap %s\nexec "%s" "$@"\n' "$id" "$runner" > "$wrapper" && chmod 755 "$wrapper"
    printf 'id=%s\nversion=%s\nsha256=%s\nsource=%s\ncmd=%s\n' "$id" "$ver" "$sha" "$src" "$cmd" > "$YAP_DIR/$id/.yse"
    sync
    msg "yap:$id $ver установлен → $cmd"
    [ -x "$OPT/bin/$cmd" ] && msg "внимание: в Entware тоже есть $cmd, он раньше в PATH; запуск этой версии: $wrapper"
    return 0
}

yap_remove_one(){
    id="$1"
    yap_installed "$id" || { err "yap:$id не установлен"; return 1; }
    cmd="$(yap_field "$id" cmd)"
    [ -n "$cmd" ] && grep -q "^# yse-yap $id\$" "$YAP_BIN/$cmd" 2>/dev/null && rm -f "$YAP_BIN/$cmd"
    rm -rf "${YAP_DIR:?}/${id:?}"; sync
    msg "yap:$id удалён"
}

yap_list_installed(){
    for f in "$YAP_DIR"/*/.yse; do
        [ -f "$f" ] || continue
        printf '%s - %s [yap/%s]\n' "$(sed -n 's/^id=//p' "$f")" "$(sed -n 's/^version=//p' "$f")" "$(sed -n 's/^source=//p' "$f")"
    done
}

yap_list_all(){
    yap_ensure_index
    yap_sources | while read -r name url; do
        [ -f "$YAP_CACHE/$name.tsv" ] && awk -F "$TAB" -v s="$name" '{printf "%s - %s - %s [yap/%s]\n", $1, $2, $5, s}' "$YAP_CACHE/$name.tsv"
    done
}

# ---------- выбор источника ----------
# печатает "ent <имя>" или "yap <имя>"
resolve(){
    case "$1" in
        ent:*) echo "ent ${1#ent:}"; return ;;
        yap:*) echo "yap ${1#yap:}"; return ;;
    esac
    if [ "$YSE_PREFER" = yap ]; then
        if [ -n "$(yap_lookup "$1")" ]; then echo "yap $1"; else echo "ent $1"; fi
    else
        if ent_has "$1" || [ -z "$(yap_lookup "$1")" ]; then echo "ent $1"; else echo "yap $1"; fi
    fi
}

# ---------- команды ----------
# вывести строки окружения для текущей сессии: eval "$(yse env)"
cmd_env(){
    echo 'export PATH="/data/opt/bin:/opt/bin:/opt/sbin:$PATH"'
    echo 'export HOME=/data/opt/home; mkdir -p "$HOME" 2>/dev/null'
    [ -r /opt/etc/profile ] && echo '[ -r /opt/etc/profile ] && . /opt/etc/profile'
}
cmd_update(){ need_ent; opkg update; cmd_yap_update; }
cmd_install(){
    [ $# -ge 1 ] || die "yse install <pkg>..."
    need_ent; rc=0
    for p in "$@"; do
        # shellcheck disable=SC2046  # "ent <имя>" / "yap <имя>" — намеренно по словам
        set -- $(resolve "$p")
        if [ "$1" = yap ]; then yap_install_one "$2" || rc=1; else opkg install "$2" || rc=1; fi
    done
    return $rc
}
cmd_remove(){
    [ $# -ge 1 ] || die "yse remove <pkg>..."
    rc=0
    for p in "$@"; do
        case "$p" in
            yap:*) yap_remove_one "${p#yap:}" || rc=1 ;;
            ent:*) need_ent; opkg remove "${p#ent:}" || rc=1 ;;
            *) if yap_installed "$p" && ! ent_installed "$p"; then yap_remove_one "$p" || rc=1
               elif yap_installed "$p"; then err "$p стоит и из Entware, и из .yap — укажи ent:$p или yap:$p"; rc=1
               else need_ent; opkg remove "$p" || rc=1; fi ;;
        esac
    done
    return $rc
}
cmd_search(){
    [ $# -ge 1 ] || die "yse search <строка>"
    ent_ready && opkg find "*$1*"
    yap_list_all | grep -i -- "$1" || true
}
cmd_info(){
    [ $# -ge 1 ] || die "yse info <pkg>"
    case "$1" in yap:*) p="${1#yap:}" ;; ent:*) need_ent; opkg info "${1#ent:}"; return ;; *) p="$1"; ent_ready && opkg info "$p" ;; esac
    line="$(yap_lookup "$p")"
    if [ -n "$line" ]; then
        echo "$line" | awk -F "$TAB" '{printf "Package: %s\nVersion: %s\nSource: yap/%s\nDescription: %s\nURL: %s\nSHA256: %s\n", $2, $3, $1, $6, $5, $4}'
        yap_installed "$p" && echo "Status: установлен $(yap_field "$p" version) → $YAP_BIN/$(yap_field "$p" cmd)"
    fi
}
cmd_upgrade(){
    need_ent; opkg upgrade
    cmd_yap_update
    for f in "$YAP_DIR"/*/.yse; do
        [ -f "$f" ] || continue
        id="$(sed -n 's/^id=//p' "$f")"; cur="$(sed -n 's/^version=//p' "$f")"
        new="$(yap_lookup "$id" | cut -f3)"
        [ -n "$new" ] && [ "$new" != "$cur" ] && { msg "yap:$id $cur → $new"; yap_install_one "$id"; }
    done
}
cmd_list(){
    if [ "${1:-}" = "-a" ] || [ "${1:-}" = "--all" ]; then
        ent_ready && opkg list; yap_list_all
    else
        ent_ready && opkg list-installed; yap_list_installed
    fi
}
cmd_sources(){
    [ -s "$YAP_SOURCES" ] || msg "свой список не задан — используется реестр по умолчанию (добавь строки \"<имя> <url index.json>\" в $YAP_SOURCES)"
    yap_sources
}

usage(){ sed -n '2,/^set -u/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

cmd="${1:-help}"; [ $# -ge 1 ] && shift
case "$cmd" in
    bootstrap|setup) cmd_bootstrap "$@" ;;
    update)          cmd_update "$@" ;;
    install|add|i)   cmd_install "$@" ;;
    remove|rm|del)   cmd_remove "$@" ;;
    list|ls)         cmd_list "$@" ;;
    search|find)     cmd_search "$@" ;;
    info|show)       cmd_info "$@" ;;
    upgrade|up)      cmd_upgrade "$@" ;;
    sources)         cmd_sources "$@" ;;
    env)             cmd_env "$@" ;;
    help|-h|--help)  usage ;;
    version|--version) echo "yse 0.4.0 (Entware + .yap, arch=$ARCH, feed=$(ent_arch))"; echo "https://hackalice.me/start/packages/" ;;
    *) err "неизвестная команда: $cmd"; usage; exit 1 ;;
esac
